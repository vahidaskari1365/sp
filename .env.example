# ─────────────────────────────────────────────────────────────
# اتصال پایگاه داده (PostgreSQL) — الزامی
# در Vercel: Project → Settings → Environment Variables
# برای Neon/Supabase از رشتهٔ اتصال Pooled استفاده کنید و
# در صورت نیاز ?sslmode=require را به انتهای آدرس اضافه کنید.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# اگر ارائه‌دهندهٔ دیتابیس SSL اجباری دارد (Neon, Supabase, Railway)
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# ─────────────────────────────────────────────────────────────
# پنل مدیریت (الزامی در محیط واقعی)
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=termeh1404
AUTH_SECRET=change-this-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# آدرس عمومی سایت — برای canonical، sitemap و Open Graph
# در Vercel اگر خالی بگذارید، به‌صورت خودکار از دامنهٔ پروژه استفاده می‌شود.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────
# اختیاری
# ─────────────────────────────────────────────────────────────
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
# ZARINPAL_MERCHANT_ID=
